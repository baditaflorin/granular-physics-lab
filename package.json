{
  "name": "granular-physics-lab",
  "version": "0.1.0",
  "description": "Browser-based granular sandbox for teaching sand, gravel, and snow behavior with WASM physics and WebGPU visuals.",
  "homepage": "https://baditaflorin.github.io/granular-physics-lab/",
  "repository": {
    "type": "git",
    "url": "https://github.com/baditaflorin/granular-physics-lab.git"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/compile-wasm.mjs && node scripts/write-build-info.mjs",
    "build": "tsc -b && vite build && node scripts/copy-404.mjs",
    "test": "vitest run",
    "smoke": "bash scripts/smoke.sh",
    "lint": "eslint . && prettier --check .",
    "fmt": "prettier --write .",
    "pages-preview": "vite preview --host 0.0.0.0",
    "hooks:pre-commit": "bash .githooks/pre-commit",
    "hooks:commit-msg": "bash .githooks/commit-msg .git/COMMIT_EDITMSG",
    "hooks:pre-push": "bash .githooks/pre-push"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "comlink": "^4.4.2",
    "lucide-react": "^1.14.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.1",
    "eslint": "^10.3.0",
    "gitleaks": "^1.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "prettier": "^3.8.3",
    "typescript-eslint": "^8.59.2",
    "vitest": "^4.1.5",
    "wabt": "^1.0.39"
  }
}
