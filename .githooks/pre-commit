#!/usr/bin/env bash
# Docs-only commits (just CLAUDE.md, the fleet-wide canonical doc sync)
# skip the full check suite below — it has nothing to check.
if [ "$(git diff --cached --name-only)" = "CLAUDE.md" ]; then
  exit 0
fi
set -euo pipefail

npm run lint
npm run test

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --verbose
elif npx --no-install gitleaks --version >/dev/null 2>&1; then
  npx --no-install gitleaks protect --staged --verbose
else
  printf "gitleaks not found; install it before pushing production changes.\n"
fi

